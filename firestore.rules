rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); 
    }
    
    // Validation Blueprints
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'brand', 'price', 'categoryId', 'stock', 'imageUrl', 'description']) && 
             data.keys().size() == 7 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.brand is string && data.brand.size() > 0 && data.brand.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 128 &&
             data.stock is number && data.stock >= 0 &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             data.description is string && data.description.size() <= 5000;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'imageUrl']) && 
             data.keys().size() == 2 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.imageUrl is string && data.imageUrl.size() <= 1000;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'shipping', 'paymentMethod', 'total', 'status', 'createdAt']) && 
             data.keys().size() == 7 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.shipping is map && data.shipping.keys().hasAll(['fullName', 'address', 'city', 'phone']) &&
             data.paymentMethod is string && data.paymentMethod.size() <= 50 &&
             data.total is number && data.total >= 0 &&
             data.status is string && data.status.size() <= 50 &&
             data.createdAt == request.time;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'disabled', 'createdAt']) && 
             data.keys().size() == 4 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.disabled is bool &&
             data.createdAt == request.time;
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // Orders
    match /orders/{orderId} {
      // User can read their own order. Admin can read any order.
      allow read: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
      
      // User can create.
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && incoming().status == 'Pending';
      
      // Admin update for status management.
      allow update: if isAdmin() && isValidId(orderId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      
      allow delete: if false; // No deletion for orders
    }

    // Users
    match /users/{userId} {
      allow read: if (isSignedIn() && userId == request.auth.uid) || isAdmin();
      
      allow create: if isSignedIn() && userId == request.auth.uid && isValidId(userId) && 
                    isValidUser(incoming()) && incoming().disabled == false;
      
      // Admin update for disability management
      allow update: if isAdmin() && isValidId(userId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['disabled']);
      allow delete: if false;
    }

    // Admins
    match /admins/{adminId} {
      // Admin checks use `exists`, read inside rule is internal. Only admin can read.
      allow read: if isAdmin();
      allow write: if false; // Only configured out of bands via console or seed
    }
  }
}
